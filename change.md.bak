## 变更 6 (P2-D)：新增 ArrayView<T> + Array::slice

### 文件：runtime/builtin/array.h

**修改 6a：新增 ArrayView 类（在 ArrayIterator 之前，L891 附近）**

```cpp
// ============================================================
// P2-D: ArrayView<T> — 零拷贝视图（Aura 层透明，视为 [T]）
//
// 持有原 Array 的引用 + 起始索引 + 长度。
// 读写视图：修改视图元素会影响原 Array（Python 切片语义）。
// GC 安全：ArrayView 是 GcObject，被 GC 追踪。
// ============================================================
template<typename T>
class ArrayView : public GcObject {
    Array<T>* owner_ = nullptr;   // 持有原 Array（GC 指针字段，需写屏障）
    int32_t start_ = 0;           // 起始索引（绝对索引）
    int32_t len_ = 0;             // 视图长度

public:
    int32_t len() const { return len_; }
    int32_t size() const { return len_; }
    bool empty() const { return len_ == 0; }

    // 元素访问：委托 owner 的 operator[]
    T& operator[](int32_t relIdx) {
        if (relIdx < 0 || relIdx >= len_) {
            throw Error{make_string("IndexError"), make_string("view index out of range")};
        }
        return (*owner_)[start_ + relIdx];
    }
    const T& operator[](int32_t relIdx) const {
        if (relIdx < 0 || relIdx >= len_) {
            throw Error{make_string("IndexError"), make_string("view index out of range")};
        }
        return (*owner_)[start_ + relIdx];
    }

    // 首尾访问
    T& front() {
        if (len_ == 0) {
            throw Error{make_string("IndexError"), make_string("front from empty view")};
        }
        return (*owner_)[start_];
    }
    T& back() {
        if (len_ == 0) {
            throw Error{make_string("IndexError"), make_string("back from empty view")};
        }
        return (*owner_)[start_ + len_ - 1];
    }

    // 嵌套 slice
    ArrayView<T>* slice(int32_t relStart, int32_t subLen) const;

    // GC 类型描述符
    static const TypeDescriptor& desc();

    // 工厂方法
    static ArrayView<T>* make(Array<T>* owner, int32_t start, int32_t len) {
        GcCompactSuspendGuard guard;
        auto* v = static_cast<ArrayView<T>*>(
            GcHeap::instance().alloc(sizeof(ArrayView<T>), &desc()));
        gc_write_barrier(v, &v->owner_, reinterpret_cast<GcObject*>(owner));
        v->owner_ = owner;
        v->start_ = start;
        v->len_ = len;
        return v;
    }
};
```

**修改 6b：ArrayView::desc 和 ArrayView::slice 实现（在 ArrayView 类之后）**

```cpp
// P2-D: ArrayView 类型描述符
// owner_ 是 GC 指针字段（偏移 0），start_/len_ 是标量（无需扫描）
template<typename T>
const TypeDescriptor& ArrayView<T>::desc() {
    static const TypeDescriptor d = {
        sizeof(ArrayView<T>),
        1,  // ptrFieldCount
        []() -> std::vector<PtrField> {
            return { PtrField{offsetof(ArrayView<T>, owner_), true} };
        }
    };
    return d;
}

// P2-D: 嵌套 slice
template<typename T>
ArrayView<T>* ArrayView<T>::slice(int32_t relStart, int32_t subLen) const {
    if (relStart < 0 || subLen < 0 || relStart + subLen > len_) {
        throw Error{make_string("IndexError"), make_string("view slice out of range")};
    }
    return make(owner_, start_ + relStart, subLen);
}
```

**修改 6c：Array 类新增 slice 方法声明（L117 附近，public 区）**

```cpp
// 在 operator[] 声明后新增：
ArrayView<T>* slice(int32_t start, int32_t len) const;
```

**修改 6d：Array 类新增前向声明（文件顶部，L26 附近）**

```cpp
// 在 ArrayIterator 前向声明后新增：
template<typename T>
class ArrayView;
```

**修改 6e：Array::slice 实现（在 operator[] 实现之后，L890 附近）**

```cpp
// ============================================================
// P2-D: Array::slice — 零拷贝视图
// ============================================================
template<typename T>
ArrayView<T>* Array<T>::slice(int32_t start, int32_t len) const {
    if (start < 0 || len < 0 || start + len > length) {
        throw Error{make_string("IndexError"), make_string("slice out of range")};
    }
    return ArrayView<T>::make(const_cast<Array<T>*>(this), start, len);
}
```

### 文件：src/Sema/BuiltinRegistry.h

**修改 6f：注册 slice 方法（L253 附近，[T] 方法列表末尾）**

```cpp
// 在 reserve 后新增：
{"[T]", "slice",    {{"start", "int"}, {"len", "int"}},  ReturnTypeInfo::Generic(0, "[T]")},
```

---

## 实施顺序

1. 变更 1 (P2-E) — front() O(1)
2. 变更 2 (P3-A) — 魔法数字提取
3. 变更 3 (P3-B) — operator[] 去重
4. 变更 4 (P3-D) — Iterator 拷贝
5. 变更 5 (P3-E) — capacity int64
6. 变更 6 (P2-D) — ArrayView + slice

## 测试方案

新建独立测试文件 `example/test.aura`（覆盖原文件，原文件可备份）：

```aura
// Array<T> 优化 P2/P3 测试

fun main(io: Io) {
    // K1: front() O(1)
    let arr: [int] = [1, 2, 3]
    io.println("=== K1: front() ===")
    io.println("front: " + arr.front())

    // K2: capacity int64
    io.println("=== K2: capacity ===")
    io.println("cap: " + arr.capacity())

    // K3: slice 零拷贝视图
    io.println("=== K3: slice view ===")
    let arr2: [int] = []
    let i: int = 0
    while i < 10 {
        arr2.append(i)
        i = i + 1
    }
    let view = arr2.slice(2, 5)
    io.println("view len: " + view.len())
    io.println("view[0]: " + view[0])
    io.println("view[4]: " + view[4])
    view[0] = 99
    io.println("after view[0]=99, arr2[2]: " + arr2[2])
    let view2 = view.slice(1, 3)
    io.println("nested view len: " + view2.len())
    io.println("nested view[0]: " + view2[0])
    gc_force()
    io.println("After GC, view[0]: " + view[0])
    io.println("=== All tests passed ===")
}
```
