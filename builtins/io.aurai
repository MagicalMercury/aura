// ============================================================
// builtins/io.aurai — Io 能力类
//
// Io 是 Aura 语言的内置能力对象，通过 fun main(io: Io) 注入。
// 所有 I/O 副作用必须通过 io 对象调用，遵循能力安全模型。
//
// C++ 双版本说明（对 Aura 用户透明）：
//   每个 I/O 方法在 C++ 中有异步版（返回 task<T>）和同步版（_sync 后缀）。
//   编译器根据上下文自动选择：
//     - 协程函数中 → co_await io.xxx()（异步版）
//     - 旧 `#io.sync = true` 指令已在 feature-21 Phase 1 移除；
//       同步版选择待 `#io{ sync = true }` 元数据（Phase 5+）重新接线，当前恒走异步路径
//   Aura 用户始终只看到一个方法签名。
//
// 声明中的 '...' = C++ 桥接标记：aura 层无实现，c++ 层有实现
// ============================================================

type Io

// 终端 I/O
fun (self Io) println(msg: string) ...
fun (self Io) readln() throws -> string ...

// 文件 I/O（Path 由 path.aurai 定义）
fun (self Io) read_file(path: Path) throws -> string ...
fun (self Io) write_file(path: Path, content: string) throws ...
fun (self Io) file_exists(path: Path) -> bool ...
fun (self Io) mkdir(path: Path) throws ...
fun (self Io) remove(path: Path) throws ...
fun (self Io) list_dir(path: Path) throws -> [Path] ...

// 路径操作
fun (self Io) cwd() -> Path ...
