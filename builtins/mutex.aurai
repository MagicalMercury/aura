type Mutex
type RWMutex
type Once
type RWMutexReadView
type RWMutexWriteView

fun sync.Mutex() -> Mutex
fun sync.RWMutex() -> RWMutex
fun sync.Once() -> Once

fun (self RWMutex) r() -> RWMutexReadView
fun (self RWMutex) w() -> RWMutexWriteView
